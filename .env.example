# LLM Configuration
# Choose which LLM provider to use: "openai" or "anthropic"
LLM_PROVIDER=openai

# Set to "true" to use LLM for response generation, "false" to use template-based responses
USE_LLM_RESPONSES=true

# OpenAI API Key (required if LLM_PROVIDER=openai)
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Anthropic API Key (required if LLM_PROVIDER=anthropic)
# Get your key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...
